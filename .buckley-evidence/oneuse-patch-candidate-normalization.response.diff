+// normalizePatchCandidate derives the candidate patch from the raw assistant
+// content using only bounded, deterministic transformations: stripping exactly
+// one whole-response ```diff fence, and appending exactly one final newline
+// when the last byte is not already a newline. No other bytes are rewritten.
+func normalizePatchCandidate(raw []byte) ([]byte, error) {
+	if bytes.IndexByte(raw, 0x00) >= 0 {
+		return nil, errors.New("response contains NUL bytes")
+	}
+	body := raw
+	if bytes.HasPrefix(raw, []byte("```diff\n")) {
+		inner := bytes.TrimSuffix(raw[len("```diff\n"):], []byte("\n"))
+		if !bytes.HasSuffix(inner, []byte("\n```")) {
+			return nil, errors.New("unclosed ```diff fence")
+		}
+		body = inner[:len(inner)-len("\n```")]
+	} else if bytes.Contains(raw, []byte("```")) {
+		return nil, errors.New("unsupported fence label or stray backticks in bare response")
+	}
+	if len(bytes.TrimSpace(body)) == 0 {
+		return nil, errors.New("empty patch body")
+	}
+	if bytes.Contains(body, []byte("```")) {
+		return nil, errors.New("nested or multiple fences")
+	}
+	if !bytes.HasPrefix(body, []byte("diff --git ")) {
+		return nil, errors.New(`patch does not begin with "diff --git "`)
+	}
+	for _, marker := range []string{"--- ", "+++ ", "@@ "} {
+		if !bytes.Contains(body, []byte(marker)) {
+			return nil, fmt.Errorf("syntactically incomplete patch: missing %q section", marker)
+		}
+	}
+	candidate := body
+	if !bytes.HasSuffix(candidate, []byte("\n")) {
+		candidate = append(append([]byte(nil), candidate...), '\n')
+	}
+	return candidate, nil
+}
 
