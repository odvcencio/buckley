+func TestCandidateIntegrationApplyRecount(t *testing.T) {
+	root := newFixtureRepo(t)
+	raw := fencedStaleCountRaw()
+	candidate, err := normalizePatchCandidate([]byte(raw))
+	if err != nil {
+		t.Fatalf("normalize: %v", err)
+	}
+	if !bytes.Equal([]byte(raw), candidate) && bytes.Contains([]byte(raw), []byte("```")) {
+		t.Fatal("fence not stripped from candidate")
+	}
+	ctx := context.Background()
+	if err := validatePatchCandidate(ctx, root, candidate); err != nil {
+		t.Fatalf("candidate rejected: %v", err)
+	}
+	if worktreeDirty(t, root) {
+		t.Fatal("validation left the worktree dirty")
+	}
+	apply := exec.Command("git", "-C", root, "apply", "--recount", "--whitespace=nowarn", "-")
+	apply.Stdin = bytes.NewReader(candidate)
+	apply.Env = append(os.Environ(), "GIT_CONFIG_NOSYSTEM=1", "GIT_TERMINAL_PROMPT=0")
+	if out, err := apply.CombinedOutput(); err != nil {
+		t.Fatalf("real apply failed: %v: %s", err, out)
+	}
+	data, err := os.ReadFile(filepath.Join(root, "sample.txt"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	if want := "return an applicable unified diff\n"; string(data) != want {
+		t.Fatalf("applied content = %q, want %q", data, want)
+	}
+}
