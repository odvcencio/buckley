+func TestWriteExclusiveOutputPermissionsAndCleanup(t *testing.T) {
+	dir := t.TempDir()
+	path := filepath.Join(dir, "out")
+	if err := writeExclusiveOutput(path, []byte("first")); err != nil {
+		t.Fatalf("first write: %v", err)
