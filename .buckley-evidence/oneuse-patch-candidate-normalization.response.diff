+func TestRequireAbsentPath(t *testing.T) {
+	dir := t.TempDir()
+	file := filepath.Join(dir, "raw.out")
+	if err := os.WriteFile(file, []byte("keep"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := requireAbsentPath(file); err == nil {
+		t.Fatal("existing regular file accepted")
+	}
+	data, err := os.ReadFile(file)
+	if err != nil || string(data) != "keep" {
+		t.Fatalf("existing file modified: %q, %v", data, err)
+	}
+	sub := filepath.Join(dir, "subdir")
+	if err := os.Mkdir(sub, 0o700); err != nil {
+		t.Fatal(err)
+	}
+	if err := requireAbsentPath(sub); err == nil {
+		t.Fatal("existing directory accepted")
+	}
+	target := filepath.Join(dir, "target")
+	if err := os.WriteFile(target, []byte("target"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	link := filepath.Join(dir, "link")
+	if err := os.Symlink(target, link); err != nil {
+		t.Fatal(err)
+	}
+	if err := requireAbsentPath(link); err == nil {
+		t.Fatal("existing symlink accepted")
+	}
+	data, err = os.ReadFile(target)
+	if err != nil || string(data) != "target" {
+		t.Fatalf("symlink target modified: %q, %v", data, err)
+	}
+	if err := requireAbsentPath(filepath.Join(dir, "missing")); err != nil {
+		t.Fatalf("absent path rejected: %v", err)
+	}
+}
