+	if info.Mode().Perm() != 0o600 {
+		t.Fatalf("mode = %v, want 0600", info.Mode().Perm())
+	}
+	if err := writeExclusiveOutput(path, []byte("second")); err == nil {
+		t.Fatal("second exclusive write accepted")
+	}
+	data, err := os.ReadFile(path)
+	if err != nil || string(data) != "first" {
+		t.Fatalf("pre-existing output clobbered or removed: %q, %v", data, err)
+	}
