+func TestNormalizePatchCandidate(t *testing.T) {
+	tests := []struct {
+		name       string
+		raw        string
+		want       string
+		wantErr    bool
+		wantChange bool // normalization changed bytes
+	}{
+		{name: "bare applicable diff", raw: applicableDiff, want: applicableDiff},
+		{name: "whole-response diff fence", raw: fencedApplicableDiff, want: applicableDiff, wantChange: true},
+		{name: "fence without final newline", raw: "```diff\n" + strings.TrimSuffix(applicableDiff, "\n") + "```", want: applicableDiff, wantChange: true},
+		{name: "missing final newline", raw: strings.TrimSuffix(applicableDiff, "\n"), want: applicableDiff, wantChange: true},
+		{name: "stale hunk counts", raw: staleCountDiff, want: staleCountDiff},
+		{name: "leading prose", raw: "Here is the patch:\n" + applicableDiff, wantErr: true},
+		{name: "trailing prose", raw: applicableDiff + "Hope that helps.\n", wantErr: true},
+		{name: "unsupported fence label", raw: "```text\n" + applicableDiff + "```\n", wantErr: true},
+		{name: "multiple fences", raw: fencedApplicableDiff + fencedApplicableDiff, wantErr: true},
+		{name: "nested fence", raw: "```diff\n```diff\n" + applicableDiff + "```\n```\n", wantErr: true},
+		{name: "unclosed fence", raw: "```diff\n" + applicableDiff, wantErr: true},
+		{name: "empty fence body", raw: "```diff\n```\n", wantErr: true},
+		{name: "empty bare response", raw: "", wantErr: true},
+		{name: "backticks in bare response", raw: "```" + applicableDiff, wantErr: true},
+		{name: "NUL content", raw: applicableDiff + "\x00", wantErr: true},
+		{name: "malformed header", raw: strings.Replace(applicableDiff, "diff --git a/sample.txt b/sample.txt\n", "diff --git broken\n", 1), wantErr: true},
+		{name: "truncated no hunk", raw: "diff --git a/sample.txt b/sample.txt\n--- a/sample.txt\n+++ b/sample.txt\n", wantErr: true},
+		{name: "truncated header only", raw: "diff --git a/sample.txt b/sample.txt\n", wantErr: true},
+		{name: "whitespace prefix", raw: " " + applicableDiff, wantErr: true},
+	}
+	for _, tc := range tests {
+		tc := tc
+		t.Run(tc.name, func(t *testing.T) {
+			got, err := normalizePatchCandidate([]byte(tc.raw))
+			if tc.wantErr {
+				if err == nil {
+					t.Fatalf("expected error, got candidate %q", got)
+				}
+				return
+			}
+			if err != nil {
+				t.Fatalf("unexpected error: %v", err)
+			}
+			if string(got) != tc.want {
+				t.Fatalf("candidate mismatch:\n got %q\nwant %q", got, tc.want)
+			}
+			repeat, err := normalizePatchCandidate([]byte(tc.raw))
+			if err != nil || !bytes.Equal(repeat, got) {
+				t.Fatalf("derivation not deterministic: %q, %v", repeat, err)
+			}
+			changed := !bytes.Equal([]byte(tc.raw), got)
+			if changed != tc.wantChange {
+				t.Fatalf("changed = %v, want %v", changed, tc.wantChange)
+			}
+		})
+	}
+}
