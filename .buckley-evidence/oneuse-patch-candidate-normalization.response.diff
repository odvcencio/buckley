+// validatePatchCandidate checks the normalized candidate against the exact
+// clean repository. --recount tolerates stale numeric hunk counts only;
+// path lookup and source context are unchanged, and neither the index nor
+// the worktree is modified.
+func validatePatchCandidate(ctx context.Context, root string, candidate []byte) error {
+	cmd := exec.CommandContext(ctx, "git", "-C", root, "apply", "--check", "--recount", "--whitespace=nowarn", "-")
+	cmd.Stdin = bytes.NewReader(candidate)
+	cmd.Env = append(os.Environ(), "GIT_CONFIG_NOSYSTEM=1", "GIT_TERMINAL_PROMPT=0")
+	var stderr bytes.Buffer
+	cmd.Stderr = &stderr
+	if err := cmd.Run(); err != nil {
+		detail := strings.TrimSpace(stderr.String())
+		const maxDetailBytes = 512
+		if len(detail) > maxDetailBytes {
+			detail = detail[:maxDetailBytes]
+		}
+		if detail == "" {
+			detail = err.Error()
+		}
+		return fmt.Errorf("git apply --check --recount rejected candidate: %s", detail)
+	}
+	return nil
+}
