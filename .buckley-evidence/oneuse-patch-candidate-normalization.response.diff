+func TestRawPreservationByteIdentity(t *testing.T) {
+	dir := t.TempDir()
+	cases := map[string]string{
+		"bare":   applicableDiff,
+		"fenced": fencedApplicableDiff,
+		"noeol":  strings.TrimSuffix(applicableDiff, "\n"),
+		"stale":  staleCountDiff,
+	}
+	for name, raw := range cases {
+		path := filepath.Join(dir, name+".raw")
+		if err := writeExclusiveOutput(path, []byte(raw)); err != nil {
+			t.Fatalf("%s: %v", name, err)
+		}
+		got, err := os.ReadFile(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if !bytes.Equal(got, []byte(raw)) {
+			t.Fatalf("%s: raw output not byte-identical", name)
+		}
+		sum := sha256.Sum256(got)
+		cand, err := normalizePatchCandidate(got)
+		if err != nil {
+			t.Fatalf("%s: normalize: %v", name, err)
+		}
+		csum := sha256.Sum256(cand)
+		same := sum == csum
+		changed := !bytes.Equal(got, cand)
+		if same == changed {
+			t.Fatalf("%s: sha equality %v inconsistent with byte change %v", name, same, changed)
+		}
+	}
+}