outcome OneshotReasoningCompatibility {
    disable_reasoning_for_forced_tools: bool
}

strategy oneshot_reasoning_compatibility returns OneshotReasoningCompatibility {
    when {
        provider.id == "openrouter"
        and model.id == "qwen/qwen3.8-flash"
    } then QwenFlashForcedTools {
        disable_reasoning_for_forced_tools: true,
    }

    else KeepReasoning {
        disable_reasoning_for_forced_tools: false,
    }
}

outcome OneshotConfig {
    action: string
    max_retries: number
    context_budget: number
    use_rlm: bool
    max_output_tokens: number
    temperature: number
    require_tool: bool
}

strategy oneshot_policy returns OneshotConfig {
    when {
        command == "commit"
    } then CommitConfig {
        action: "configure",
        max_retries: 3,
        context_budget: 8000,
        use_rlm: false,
        max_output_tokens: 4096,
        temperature: 0.2,
        require_tool: true,
    }

    when {
        command == "pr"
    } then PRConfig {
        action: "configure",
        max_retries: 3,
        context_budget: 16000,
        use_rlm: false,
        max_output_tokens: 8192,
        temperature: 0.2,
        require_tool: true,
    }

    when {
        command == "review"
    } then ReviewConfig {
        action: "configure",
		max_retries: 2,
        context_budget: 32000,
        use_rlm: true,
        max_output_tokens: 0,
        temperature: 0,
        require_tool: false,
    }

	when {
		command == "review-pr"
	} then PRReviewConfig {
		action: "configure",
		max_retries: 2,
		context_budget: 32000,
		use_rlm: true,
        max_output_tokens: 0,
        temperature: 0,
        require_tool: false,
	}

    else DefaultConfig {
        action: "configure",
        max_retries: 2,
        context_budget: 8000,
        use_rlm: false,
        max_output_tokens: 0,
        temperature: 0,
        require_tool: false,
    }
}
