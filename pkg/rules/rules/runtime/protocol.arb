// Adaptive execution protocol policy.
//
// Profile facts carry capability and observed behavior; this policy decides
// how much choice, fan-out, and continuation the harness may grant. It never
// identifies a provider or model by name, so operators can revise profile
// facts or override this policy without hidden vendor switches.

outcome ProtocolChoice {
    name: string
    visible_tool_count: number
    max_turns: number
    max_fanout: number
    context_source: string
    code_mode: string
    continuation: bool
    verification_depth: string
    max_verification_attempts: number
    read_only_warning_at: number
    read_only_action_at: number
    max_read_only_calls: number
    reasoning_effort: string
    reasoning_max_tokens: number
    max_output_tokens: number
    architect_editor_split: bool
}

strategy compile returns ProtocolChoice {
    // Read-only tasks need an evidence loop, not mutation tools. Ordering is
    // intentional: the compiler skips unavailable entries, then fills any
    // remaining slots deterministically from the host's candidate set.
    when {
        model.class == "weak"
        and task.class in ["review", "analysis", "research", "audit"]
    } then WeakEvidenceStages {
        name: "weak_evidence_stages",
        visible_tool_count: 4,
        max_turns: 10,
        max_fanout: 1,
        context_source: "canopy_ranked",
        code_mode: "suggest",
        continuation: false,
        verification_depth: "focused",
        max_verification_attempts: 2,
        read_only_warning_at: 0,
        read_only_action_at: 0,
        max_read_only_calls: 0,
        reasoning_effort: "medium",
        reasoning_max_tokens: 2048,
        max_output_tokens: 6144,
        architect_editor_split: true,
    }

    when {
        model.class == "weak"
    } then WeakTypedStages {
        name: "weak_typed_stages",
        visible_tool_count: 4,
        // Fourteen turns preserves the prior five-call discovery action
        // boundary, adds a bounded edit-argument repair window, and still
        // leaves room for one focused verification pass plus honest synthesis.
        max_turns: 14,
        max_fanout: 1,
        context_source: "canopy_ranked",
        code_mode: "suggest",
        continuation: false,
        verification_depth: "focused",
        max_verification_attempts: 2,
        read_only_warning_at: 3,
        read_only_action_at: 5,
        max_read_only_calls: 9,
        reasoning_effort: "medium",
        reasoning_max_tokens: 2048,
        max_output_tokens: 6144,
        architect_editor_split: true,
    }

    when {
        model.class == "frontier"
        and task.parallelizable == true
        and task.risk != "high"
        and rollout.dynamic == true
        and rollout.auto_code_mode == true
        and model.code_mode == true
    } then FrontierParallel {
        name: "frontier_parallel",
        visible_tool_count: 12,
        max_turns: 36,
        max_fanout: 3,
        context_source: "canopy_ranked",
        code_mode: "auto_read_only",
        continuation: true,
        verification_depth: "risk_triggered",
        max_verification_attempts: 3,
        read_only_warning_at: 8,
        read_only_action_at: 14,
        max_read_only_calls: 20,
        reasoning_effort: "high",
        reasoning_max_tokens: 8192,
        max_output_tokens: 16384,
        architect_editor_split: false,
    }

    when {
        model.class == "frontier"
    } then FrontierHorizon {
        name: "frontier_horizon",
        visible_tool_count: 12,
        max_turns: 36,
        max_fanout: 1,
        context_source: "canopy_ranked",
        code_mode: "suggest",
        continuation: true,
        verification_depth: "risk_triggered",
        max_verification_attempts: 3,
        read_only_warning_at: 8,
        read_only_action_at: 14,
        max_read_only_calls: 20,
        reasoning_effort: "high",
        reasoning_max_tokens: 8192,
        max_output_tokens: 16384,
        architect_editor_split: false,
    }

    else BalancedProtocol {
        name: "balanced_protocol",
        visible_tool_count: 8,
        max_turns: 20,
        max_fanout: 1,
        context_source: "canopy_ranked",
        code_mode: "suggest",
        continuation: false,
        verification_depth: "focused",
        max_verification_attempts: 2,
        read_only_warning_at: 5,
        read_only_action_at: 8,
        max_read_only_calls: 12,
        reasoning_effort: "medium",
        reasoning_max_tokens: 4096,
        max_output_tokens: 8192,
        architect_editor_split: false,
    }
}
