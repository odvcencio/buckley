outcome PermissionOutcome {
    action: string
    rule_id: string
    tool_pattern: string
    arg_pattern: string
    command_class: string
    outside_workspace_only: bool
}

// Mirrors policy.BuiltinDefaultRules() (pkg/policy/builtin_defaults.go).
// Both implementations must agree for every input; see the parity test in
// pkg/policy/builtin_defaults_test.go.
strategy builtin_defaults_policy returns PermissionOutcome {
    when {
        tool == "run_shell"
        and command_class == "agent_harness"
    } then DenyAgentHarnessShell {
        action: "deny",
        rule_id: "builtin.deny-agent-harness-shell",
        tool_pattern: "run_shell",
        arg_pattern: "",
        command_class: "agent_harness",
        outside_workspace_only: false,
    }

    when {
        arg matches "(^|/)\.env$"
    } then DenyDotEnv {
        action: "deny",
        rule_id: "builtin.deny-dotenv",
        tool_pattern: "*",
        arg_pattern: "**/.env",
        command_class: "",
        outside_workspace_only: false,
    }

    when {
        arg matches "(^|/)\.env\.[^/]*$"
    } then DenyDotEnvVariant {
        action: "deny",
        rule_id: "builtin.deny-dotenv-variant",
        tool_pattern: "*",
        arg_pattern: "**/.env.*",
        command_class: "",
        outside_workspace_only: false,
    }

    when {
        arg matches "(^|/)[^/]*credentials[^/]*$"
    } then DenyCredentials {
        action: "deny",
        rule_id: "builtin.deny-credentials",
        tool_pattern: "*",
        arg_pattern: "**/*credentials*",
        command_class: "",
        outside_workspace_only: false,
    }

    when {
        arg matches "(^|/)id_rsa[^/]*$"
    } then DenyIDRSA {
        action: "deny",
        rule_id: "builtin.deny-id-rsa",
        tool_pattern: "*",
        arg_pattern: "**/id_rsa*",
        command_class: "",
        outside_workspace_only: false,
    }

    when {
        tool == "run_shell"
        and workspace_relative == false
        and arg matches "rm -rf"
    } then AskShellRmRf {
        action: "ask",
        rule_id: "builtin.ask-shell-rm-rf",
        tool_pattern: "run_shell",
        arg_pattern: "*rm -rf*",
        command_class: "",
        outside_workspace_only: true,
    }

    when {
        tool == "run_shell"
        and workspace_relative == false
        and arg matches "rm -r -f"
    } then AskShellRmRF {
        action: "ask",
        rule_id: "builtin.ask-shell-rm-r-f",
        tool_pattern: "run_shell",
        arg_pattern: "*rm -r -f*",
        command_class: "",
        outside_workspace_only: true,
    }

    when {
        tool == "run_shell"
        and workspace_relative == false
        and arg matches "(?s)git push.*--force"
    } then AskShellForcePushLong {
        action: "ask",
        rule_id: "builtin.ask-shell-force-push-long",
        tool_pattern: "run_shell",
        arg_pattern: "*git push*--force*",
        command_class: "",
        outside_workspace_only: true,
    }

    when {
        tool == "run_shell"
        and workspace_relative == false
        and arg matches "(?s)git push.*-f"
    } then AskShellForcePushShort {
        action: "ask",
        rule_id: "builtin.ask-shell-force-push-short",
        tool_pattern: "run_shell",
        arg_pattern: "*git push*-f*",
        command_class: "",
        outside_workspace_only: true,
    }

    when {
        tool == "run_shell"
        and workspace_relative == false
        and arg matches "(?s)curl.*\|.*sh"
    } then AskShellCurlSh {
        action: "ask",
        rule_id: "builtin.ask-shell-curl-sh",
        tool_pattern: "run_shell",
        arg_pattern: "*curl*|*sh*",
        command_class: "",
        outside_workspace_only: true,
    }

    when {
        tool == "run_shell"
        and workspace_relative == false
        and arg matches "(?s)curl.*\|.*bash"
    } then AskShellCurlBash {
        action: "ask",
        rule_id: "builtin.ask-shell-curl-bash",
        tool_pattern: "run_shell",
        arg_pattern: "*curl*|*bash*",
        command_class: "",
        outside_workspace_only: true,
    }

    when {
        tool == "run_code"
        and workspace_relative == false
        and arg matches "rm -rf"
    } then AskCodeRmRf {
        action: "ask",
        rule_id: "builtin.ask-code-rm-rf",
        tool_pattern: "run_code",
        arg_pattern: "*rm -rf*",
        command_class: "",
        outside_workspace_only: true,
    }

    else NoMatch {
        action: "",
        rule_id: "",
        tool_pattern: "",
        arg_pattern: "",
        command_class: "",
        outside_workspace_only: false,
    }
}
