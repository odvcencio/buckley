\t\tb.handleToolStarted(event)
\tcase telemetry.EventToolCompleted, telemetry.EventToolFailed:
\t\tstatus := widgets.ActivityCompleted
\t\tif event.Type == telemetry.EventToolFailed {
\t\t\tstatus = widgets.ActivityFailed
\t\t}
\t\tb.handleToolActivity(event, status)
\t\tb.handleToolFinished(event)
\tcase telemetry.EventSubagentSpawned, telemetry.EventSubagentState:
\t\tb.handleSubagentActivity(event)
\t\tb.handleSubagentActive(event)
\tcase telemetry.EventSubagentCompleted, telemetry.EventSubagentFailed, telemetry.EventSubagentCancelled:
\t\tb.handleSubagentActivity(event)
\t\tb.removeRunningTool(event.TaskID)
''',
)
