# Keep transcript progress compact and send full output to telemetry/inspector.
replace_once(
    "pkg/ui/tui/tool_loop.go",
    '''\ttoolCtx := ctx
\tstreamingShellOutput := tc.Function.Name == "run_shell"
\tif streamingShellOutput {
\t\tc.app.AppendToLastMessage("\n\n```text\n")
\t\ttoolCtx = builtin.WithShellOutputSink(ctx, func(_ string, text string) {
\t\t\tc.app.AppendToLastMessage(text)
\t\t})
\t}
\tc.app.StartProcessStatus(fmt.Sprintf("Running %s (%d/%d) · Ctrl+C to interrupt", compactStatusText(tc.Function.Name, 36), index, total))
\tresult, execErr := sess.ToolRegistry.ExecuteWithContext(toolCtx, tc.Function.Name, params)
\tc.app.StopProcessStatus()
\tif streamingShellOutput {
\t\tc.app.AppendToLastMessage("\n```")
\t}
''',
    '''\tc.app.StartProcessStatus(fmt.Sprintf("Running %s (%d/%d) · Ctrl+C to interrupt", compactStatusText(tc.Function.Name, 36), index, total))
\tresult, execErr := sess.ToolRegistry.ExecuteWithContext(ctx, tc.Function.Name, params)
\tc.app.StopProcessStatus()
''',
)
replace_once(
    "pkg/ui/tui/tool_loop.go",
    '''func toolCallProgressBlock(tc model.ToolCall) string {
\tname := strings.TrimSpace(tc.Function.Name)
\tif name == "" {
\t\tname = "tool"
\t}
\tdetail := compactToolArguments(tc.Function.Arguments, 600)
\tif detail == "" || detail == "{}" {
\t\treturn "→ " + name
\t}
\treturn "→ " + name + "\n\n" + detail
}
''',
