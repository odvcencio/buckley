replace_once(
    "pkg/ui/tui/app_widget.go",
    '''// toggleSidebar toggles the sidebar visibility and rebuilds the layout.
func (a *WidgetApp) toggleSidebar() {
\ta.sidebarWanted = !a.sidebarWanted
\ta.updateSidebarVisibility()
\tif a.sidebarVisible {
\t\ta.setStatusOverride("Sidebar shown", 2*time.Second)
\t} else {
\t\ta.setStatusOverride("Sidebar hidden", 2*time.Second)
\t}
}

// rebuildLayout rebuilds the main area layout based on sidebar visibility.
func (a *WidgetApp) rebuildLayout() {
\t// Get current screen size
\tw, h := a.screen.Size()

\t// Rebuild main area with or without sidebar
\tif a.sidebarVisible {
\t\ta.mainArea = runtime.HBox(
\t\t\texpandFromZero(a.chatView),
\t\t\truntime.Sized(a.sidebar, 24),
\t\t)
\t} else {
\t\ta.mainArea = runtime.HBox(
\t\t\texpandFromZero(a.chatView),
\t\t)
\t}

\t// Rebuild root with new main area
\ta.root = runtime.VBox(
\t\truntime.Fixed(a.header),
\t\texpandFromZero(a.mainArea),
\t\truntime.Fixed(a.inputArea),
\t\truntime.Fixed(a.statusBar),
\t)

\t// Update screen with new root
\ta.screen.PopLayer()
\ta.screen.PushLayer(a.root, false)
\ta.screen.Resize(w, h)

\ta.dirty = true
}
''',
    '''// toggleSidebar toggles the navigator visibility and rebuilds the layout.
func (a *WidgetApp) toggleSidebar() {
\ta.sidebarWanted = !a.sidebarWanted
\ta.updateSidebarVisibility()
\tif a.sidebarVisible {
\t\ta.setStatusOverride("Navigator shown", 2*time.Second)
\t} else {
\t\ta.setStatusOverride("Navigator hidden", 2*time.Second)
\t}
}

// rebuildLayout rebuilds the three-region workspace based on panel state.
func (a *WidgetApp) rebuildLayout() {
\tw, h := a.screen.Size()
\ta.mainArea = a.buildWorkspaceMainArea()
\ta.root = runtime.VBox(
\t\truntime.Fixed(a.header),
\t\texpandFromZero(a.mainArea),
\t\truntime.Fixed(a.inputArea),
\t\truntime.Fixed(a.statusBar),
\t)
\ta.screen.SetRoot(a.root)
\ta.screen.Resize(w, h)
\ta.dirty = true
}
''',
)

