# Subagent details become inspectable activity records.
replace_once(
    "pkg/subagent/manager.go",
    '''\tif snapshot.Spec != "" {
\t\tdata["spec"] = snapshot.Spec
\t}
''',
    '''\tif snapshot.Task != "" {
\t\tdata["task"] = snapshot.Task
\t}
\tif snapshot.Output != "" {
\t\tdata["output"] = boundedTelemetryOutput(snapshot.Output)
\t}
\tif snapshot.Spec != "" {
\t\tdata["spec"] = snapshot.Spec
\t}
''',
)
replace_once(
    "pkg/subagent/manager.go",
    '''func boundedTask(task string) string {
\ttask = strings.TrimSpace(task)
\tif len(task) <= 4096 {
\t\treturn task
\t}
\treturn task[:4093] + "..."
}
''',
    '''func boundedTask(task string) string {
\ttask = strings.TrimSpace(task)
\tif len(task) <= 4096 {
\t\treturn task
\t}
\treturn task[:4093] + "..."
}

func boundedTelemetryOutput(output string) string {
\tconst limit = 64 * 1024
\toutput = strings.TrimSpace(output)
\tif len(output) <= limit {
\t\treturn output
\t}
\tconst marker = "\\n... subagent telemetry truncated ...\\n"
\tavailable := limit - len(marker)
\thead := available * 2 / 3
\ttail := available - head
\treturn output[:head] + marker + output[len(output)-tail:]
}
''',
)

# Markdown++ terminal affordances and semantic scrollbar interaction.
replace_once(
    "pkg/ui/widgets/chatview.go",
    '''\t// Callbacks
\tonScrollChange func(top, total, viewHeight int)
''',
    '''\t// Callbacks
\tonScrollChange  func(top, total, viewHeight int)
\tscrollbarDragging bool
''',
)
replace_once(
    "pkg/ui/widgets/chatview.go",
    '''\tmdLines := c.mdRenderer.RenderWidth(source, markdownPPForTerminal(content), c.markdownRenderWidth())
''',
