{
  "name": "@buckley/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:backend\" \"npm:dev:electron\"",
    "dev:backend": "go run ../../cmd/buckley serve --browser --bind 127.0.0.1:4488",
    "dev:electron": "wait-on tcp:4488 && cross-env BUCKLEY_SPAWN_BACKEND=0 electron .",
    "build": "../../scripts/build-ui.sh",
    "package": "npm run build && (cd ../.. && go build -o apps/desktop/dist/buckley ./cmd/buckley)",
    "preview": "npm run dev:electron",
    "start": "npm run package && electron ."
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.2",
    "wait-on": "^7.0.1"
  }
}
