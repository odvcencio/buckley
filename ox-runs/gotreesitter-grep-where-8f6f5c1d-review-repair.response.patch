+func splitClauses(s string) ([]string, error) {
 	var clauses []string
 	var cur strings.Builder
 	var quote byte
 	var bs int
 	for i := 0; i < len(s); i++ {
 		c := s[i]
 		switch {
 		case quote != 0:
 			cur.WriteByte(c)
 			if c == '\\' {
 				bs++
 				continue
 			}
 			if c == quote && bs%2 == 0 {
 				quote = 0
 			}
 			bs = 0
 		case c == '"' || c == '\'':
+			if !atArgumentStart(cur.String()) {
+				cur.WriteByte(c)
+				continue
+			}
 			quote = c
 			bs = 0
 			cur.WriteByte(c)
 		case c == ';' || c == '\n':
 			clauses = append(clauses, cur.String())
 			cur.Reset()
 		default:
 			cur.WriteByte(c)
 		}
