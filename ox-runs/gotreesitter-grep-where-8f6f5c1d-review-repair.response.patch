 }
+
+// atArgumentStart reports whether the text accumulated so far ends in a
+// position where a new argument may begin: right after '(' or ',', or at
+// the very start of the clause stream.
+func atArgumentStart(acc string) bool {
+	i := len(acc) - 1
+	for i >= 0 && (acc[i] == ' ' || acc[i] == '\t' || acc[i] == '\r' || acc[i] == '\n') {
+		i--
+	}
+	if i < 0 {
+		return true
+	}
+	return acc[i] == '(' || acc[i] == ','
+}
 
