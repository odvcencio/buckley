+func TestCompileWhereApostropheInUnquotedArg(t *testing.T) {
+	pred, err := CompileWhere(`contains($NAME, don't); contains($NAME, stop)`)
+	if err != nil {
+		t.Fatalf("unexpected error: %v", err)
+	}
+	cap := &Capture{Name: "NAME", Text: "don't stop"}
+	if !pred(cap) {
+		t.Fatalf("expected match for %q", cap.Text)
+	}
+	cap2 := &Capture{Name: "NAME", Text: "don't go"}
+	if pred(cap2) {
+		t.Fatalf("expected no match for %q", cap2.Text)
+	}
+}
