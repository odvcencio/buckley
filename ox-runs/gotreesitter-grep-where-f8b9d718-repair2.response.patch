+			var out strings.Builder
+			for i := 0; i < len(s); i++ {
+				if s[i] == '\\' && i+1 < len(s) && s[i+1] == q {
+					out.WriteByte(q)
+					i++
+					continue
+				}
+				out.WriteByte(s[i])
+			}
+			return out.String()
 		}
 	}
 	return s
