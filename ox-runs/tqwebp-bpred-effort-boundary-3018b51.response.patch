+// bPredRDAdvantageMargin returns the minimum RD advantage, in Q8 score
+// units, required before a macroblock may switch to B_PRED.
+//
+// Invariant: the exact per-macroblock score prices only this macroblock,
+// but accepting B_PRED rewrites the intra-mode context that every later
+// macroblock prices against. A win smaller than the rate-equivalent of
+// the distortion-admission bar (the same penalty that gates
+// reconstruction improvement) is context noise, not a decisive win, and
+// must leave the macroblock whole. The margin is therefore
+// lambda*penalty: penalty is the established SSE-domain admission bar,
+// and lambda converts distortion units into this score's rate domain.
+// The product is overflow-checked and saturates, which can only reject.
+func bPredRDAdvantageMargin(lambda, penalty uint64) uint64 {
+	if lambda == 0 || penalty == 0 {
+		return 0
+	}
+	if lambda > ^uint64(0)/penalty {
+		return ^uint64(0)
+	}
+	return lambda * penalty
+}
+
+// bPredWinsRD reports whether the B_PRED candidate beats the whole-block
+// candidate by a strict RD advantage exceeding margin. An exact score
+// tie, or any non-positive advantage, stays whole-block.
+func bPredWinsRD(wholeDistortion, bPredDistortion int32, wholeRate, bPredRate lumaRateQ8, lambda, margin uint64) bool {
+	wholeScore := rdScore(wholeDistortion, wholeRate.total(), lambda)
+	bPredScore := rdScore(bPredDistortion, bPredRate.total(), lambda)
+	if bPredScore >= wholeScore {
+		return false
+	}
+	return wholeScore-bPredScore > margin
+}
+
