+package encoder
+
+import (
+	"m31labs.dev/tqwebp/internal/cost"
+	"m31labs.dev/tqwebp/internal/frame"
+)
+
+// Static bounds for the dormant segment assignment planner. All loops in this
+// file run a fixed number of iterations determined solely by the input length;
+// there is no randomness, floating point, map usage, recursion, goroutines, or
+// convergence-until-stable control flow.
+const (
+	segmentAssignmentMaxSegments     = 4
+	segmentAssignmentExhaustiveLimit = 6
+)
+
+// segmentAssignmentResult is the private planning evidence returned by
+// assignSegments. It is byte-inert: nothing in the encoder consumes it yet.
+type segmentAssignmentResult struct {
+	// IDs is in macroblock raster order. When Enabled is false it is filled
+	// with zeros and has the same length as the input.
+	IDs []uint8
+	// Segmentation is the frame-level segmentation state implied by the plan.
+	// It is the zero value when the plan is disabled.
+	Segmentation frame.Segmentation
+	// Enabled reports whether the enabled plan beat the disabled baseline on
+	// a strict rate-domain payoff.
+	Enabled bool
+	// Gain echoes the supplied content-score gain in Q8 rate units.
+	Gain cost.Cost
+	// EnabledCost prices the enabled plan exactly once via
+	// priceSegmentControl; it already contains the map update gates,
+	// probability literals, and ID records. segmentMapPlan.SignalCost and
+	// segmentMapPlan.IDCost are never added again.
+	EnabledCost segmentControlCost
+	// DisabledCost prices the disabled baseline exactly once via
+	// priceSegmentControl(frame.Segmentation{}, nil).
+	DisabledCost segmentControlCost
+	// CandidatesEvaluated exposes bounded candidate statistics for tests.
+	CandidatesEvaluated int
+	// ExhaustiveSearch reports whether the exhaustive small-input path ran.
+	ExhaustiveSearch bool
+}
+
+// assignSegments plans a 1..4 segment assignment for raster-ordered features.
+// gain is the supplied content-score gain in Q8 rate units; the plan is
+// enabled only when gain strictly exceeds the incremental control rate
+// (enabled.TotalCost - disabled.TotalCost). The input slice is never mutated.
+func assignSegments(features []segmentFeature, gain cost.Cost) segmentAssignmentResult {
+	n := len(features)
+	res := segmentAssignmentResult{Gain: gain}
+	res.DisabledCost = priceSegmentControl(frame.Segmentation{}, nil)
+	if n == 0 {
+		return res
+	}
+	res.ExhaustiveSearch = n <= segmentAssignmentExhaustiveLimit
+
+	bestPayoff := cost.Cost(0) // strict gain required to enable
+	var bestIDs []uint8
+	var bestPlan segmentMapPlan
+	var bestControl segmentControlCost
+	found := false
+
+	eval := func(cand []uint8) {
+		res.CandidatesEvaluated++
+		can := canonicalizeSegmentIDs(cand, n)
+		if can == nil {
+			return
+		}
+		can = collapseEquivalentClusters(can, features)
+		if len(can) != n {
+			return
+		}
+		plan := deriveSegmentMapPlan(can)
+		ctrl := priceSegmentControl(segmentationFromPlan(plan), can)
+		payoff := gain - (ctrl.TotalCost - res.DisabledCost.TotalCost)
+		if !found || payoff > bestPayoff || (payoff == bestPayoff && segmentIDLexLess(can, bestIDs)) {
+			found = true
+			bestPayoff = payoff
+			bestIDs = append(bestIDs[:0], can...)
+			bestPlan = plan
+			bestControl = ctrl
+		}
+	}
+
+	if res.ExhaustiveSearch {
+		// Fixed iteration count: exactly segmentAssignmentMaxSegments^n
+		// labelings, enumerated in lexicographic order via a mixed-radix
+		// counter. No recursion, no maps, no randomness.
+		cur := make([]uint8, n)
+		for {
+			eval(cur)
+			i := n - 1
+			for i >= 0 && cur[i] == segmentAssignmentMaxSegments-1 {
+				cur[i] = 0
+				i--
+			}
+			if i < 0 {
+				break
+			}
+			cur[i]++
+		}
+	} else {
+		// Fixed candidate count: one single-segment baseline plus three
+		// threshold families x three prefix lengths = 19 candidates total,
+		// independent of n.
+		cur := make([]uint8, n)
+		eval(cur)
+		for kind := 0; kind < 3; kind++ {
+			var th [3]uint32
+			switch kind {
+			case 0:
+				th = [3]uint32{64, 128, 192}
+			case 1:
+				th = [3]uint32{30000, 60000, 90000}
+			default:
+				th = [3]uint32{266342400, 532684800, 799027200}
+			}
+			for k := 1; k <= 3; k++ {
+				applySegmentThresholds(cur, features, kind, th, k)
+				eval(cur)
+			}
+		}
+	}
+
+	// Fail closed: any inconsistent internal state falls back to disabled.
+	if !found || len(bestIDs) != n {
+		res.IDs = make([]uint8, n)
+		res.Enabled = false
+		res.Segmentation = frame.Segmentation{}
+		res.EnabledCost = segmentControlCost{}
+		return res
+	}
+
+	// The selected IDs are derived and priced exactly once; the winner's
+	// already-computed plan and control ledger are transferred verbatim, so
+	// SignalCost/IDCost from deriveSegmentMapPlan are never double counted.
+	res.Enabled = true
+	res.IDs = append([]uint8(nil), bestIDs...)
+	res.Segmentation = segmentationFromPlan(bestPlan)
+	res.EnabledCost = bestControl
+	return res
+}
+
+// segmentationFromPlan builds the enabled frame state for a derived plan.
+func segmentationFromPlan(p segmentMapPlan) frame.Segmentation {
+	var s frame.Segmentation
+	s.Enabled = true
+	s.UpdateMap = true
+	s.UpdateData = false
+	s.TreeProbs = p.Probs
+	return s
+}
+
+// canonicalizeSegmentIDs relabels src so that IDs are assigned 0,1,2,... in
+// order of first raster occurrence. Empty clusters vanish. It returns nil on
+// any out-of-range label.
+func canonicalizeSegmentIDs(src []uint8, n int) []uint8 {
+	out := make([]uint8, n)
+	var remap [segmentAssignmentMaxSegments]int8
+	for i := range remap {
+		remap[i] = -1
+	}
+	next := int8(0)
+	for i := 0; i < n; i++ {
+		l := src[i]
+		if int(l) >= segmentAssignmentMaxSegments {
+			return nil
+		}
+		if remap[l] < 0 {
+			remap[l] = next
+			next++
+		}
+		out[i] = uint8(remap[l])
+	}
+	return out
+}
+
+// collapseEquivalentClusters merges clusters with identical feature
+// aggregates into the lowest involved ID, repeating a bounded number of
+// passes (at most segmentAssignmentMaxSegments-1 merges can occur).
+func collapseEquivalentClusters(ids []uint8, feats []segmentFeature) []uint8 {
+	type clusterAgg struct {
+		count    int
+		sumMean  uint64
+		sumVar   uint64
+		sumEdge  uint64
+	}
+	for pass := 0; pass < segmentAssignmentMaxSegments; pass++ {
+		var aggs [segmentAssignmentMaxSegments]clusterAgg
+		for i := range feats {
+			a := &aggs[ids[i]]
+			a.count++
+			a.sumMean += uint64(feats[i].Mean)
+			a.sumVar += uint64(feats[i].Variance)
+			a.sumEdge += uint64(feats[i].Edge)
+		}
+		merged := false
+		for j := 1; j < segmentAssignmentMaxSegments && !merged; j++ {
+			if aggs[j].count == 0 {
+				continue
+			}
+			for i := 0; i < j; i++ {
+				if aggs[i].count == 0 {
+					continue
+				}
+				if aggs[i] == aggs[j] {
+					for k := range ids {
+						if ids[k] == uint8(j) {
+							ids[k] = uint8(i)
+						}
+					}
+					merged = true
+					break
+				}
+			}
+		}
+		if !merged {
+			break
+		}
+		fixed := canonicalizeSegmentIDs(ids, len(ids))
+		if fixed == nil {
+			return ids
+		}
+		copy(ids, fixed)
+	}
+	return ids
+}
+
+// segmentIDLexLess reports whether a is lexicographically smaller than b,
+// implementing the lower-ID tie rule at the first differing raster position.
+func segmentIDLexLess(a, b []uint8) bool {
+	n := len(a)
+	if len(b) < n {
+		n = len(b)
+	}
+	for i := 0; i < n; i++ {
+		if a[i] != b[i] {
+			return a[i] < b[i]
+		}
+	}
+	return false
+}
+
+// applySegmentThresholds fills dst with threshold-rank labels derived from
+// one feature channel. Clusters may come out empty; canonicalization removes
+// them later.
+func applySegmentThresholds(dst []uint8, feats []segmentFeature, kind int, th [3]uint32, k int) {
+	for i := range feats {
+		var v uint32
+		switch kind {
+		case 0:
+			v = uint32(feats[i].Mean)
+		case 1:
+			v = feats[i].Variance
+		default:
+			v = feats[i].Edge
+		}
+		id := uint8(0)
+		for t := 0; t < k; t++ {
+			if v >= th[t] {
+				id++
+			}
+		}
+		dst[i] = id
+	}
+}
